# Reference only. VizLens v1 does NOT auto-load .env files.
# Recommended: set this as a Windows User environment variable.
GEMINI_API_KEY=replace-with-your-current-gemini-key

# Optional hardening after loading the unpacked extension:
# VIZLENS_EXTENSION_ORIGIN=chrome-extension://your-extension-id

# Optional for VizLens Power Ops repository hub.
# Without a token, the hub lists only public repositories for GITHUB_OWNER.
# Use a fine-grained token with read-only Metadata/Contents access to the repos you want to list.
GITHUB_OWNER=julian-passebecq
GITHUB_TOKEN=replace-with-a-read-only-github-token
